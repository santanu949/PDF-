# Database
DATABASE_URL=postgresql://user:password@postgres:5432/pdfflow

# Redis
REDIS_URL=redis://redis:6379/0

# Security
SECRET_KEY=replace_with_a_super_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Backend Base URL (used in emails or external links)
BASE_URL=http://localhost:8000

# Groq (AI Features)
GROQ_API_KEY=your_groq_api_key

# Cloudinary (File Storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional System Binary Overrides
# For Docker, these are automatically in PATH so they can remain empty or commented out.
# POPPLER_PATH=
# GHOSTSCRIPT_PATH=
# LIBREOFFICE_PATH=
# TESSERACT_PATH=
